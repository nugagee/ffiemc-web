RewriteEngine On

# Stable public feed. Must run before the build/ rewrite.
RewriteRule ^feeds/content-emails\.json$ https://mpdvjaotalklzftktuuv.supabase.co/functions/v1/content-email-feed [R=302,L]

# If request already targets build folder, do nothing
RewriteRule ^build/ - [L]

# If file or directory exists in root, serve normally
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Redirect everything else to build
RewriteRule ^(.*)$ build/$1 [L]